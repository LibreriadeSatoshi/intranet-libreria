# --- Core (generate: openssl rand -base64 48) ---
PG_PASS=change-me
AUTHENTIK_SECRET_KEY=change-me-long-random

# --- First boot only: creates akadmin + API token without the browser wizard ---
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-hex
AUTHENTIK_BOOTSTRAP_EMAIL=admin@libreriadesatoshi.com

AUTHENTIK_ERROR_REPORTING__ENABLED=false

# --- OAuth apps (create in GitHub Settings / Google Cloud Console, see README) ---
GITHUB_SOURCE_CLIENT_ID=change-me
GITHUB_SOURCE_CLIENT_SECRET=change-me
GOOGLE_SOURCE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_SOURCE_CLIENT_SECRET=change-me

# --- Intranet OIDC client (same values go in the intranet's Auth.js config) ---
INTRANET_OIDC_CLIENT_ID=lds-intranet
INTRANET_OIDC_CLIENT_SECRET=change-me-long-random
INTRANET_OIDC_REDIRECT_URI=https://intranet.libreriadesatoshi.com/api/auth/callback/authentik
